# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

DJANGO_DB_ENGINE=sqlite
# DJANGO_SQLITE_PATH=/absolute/path/to/db.sqlite3

# Email (Brevo SMTP). With DJANGO_EMAIL_HOST empty, mail is printed to the
# console instead of sent.
SITE_URL=http://localhost:5173
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
# Brevo: Settings > SMTP & API > SMTP. The login looks like 123abc@smtp-brevo.com
# and the password is an SMTP key, not your account password.
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
# Must be a sender or domain verified in Brevo.
DJANGO_DEFAULT_FROM_EMAIL="wh1t3r4v3n <noreply@localhost>"
# Contact-form messages are forwarded here. Leave empty to only store them.
CONTACT_NOTIFY_EMAIL=
# Brevo's free plan sends 300 a day; this leaves room for confirmations.
NEWSLETTER_DAILY_SEND_LIMIT=250
NEWSLETTER_CONFIRMATIONS_PER_HOUR=30

# Optional seed account (used only by backend/seed_posts.py)
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=replace-with-a-strong-password
BLOG_ADMIN_EMAIL=admin@example.com

# Vite: leave empty for the same-origin /api proxy.
VITE_API_BASE_URL=/api
