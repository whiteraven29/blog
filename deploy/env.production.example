DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=blog.wh1teraven.site,localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://blog.wh1teraven.site
DJANGO_CSRF_TRUSTED_ORIGINS=https://blog.wh1teraven.site
DJANGO_LOG_LEVEL=INFO

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DJANGO_MEDIA_ROOT=/var/www/shared/whiteraven-blog/media
DJANGO_STATIC_ROOT=/var/www/shared/whiteraven-blog/static
DJANGO_UPLOAD_TEMP_DIR=/var/www/tmp/whiteraven-blog/uploads
TMPDIR=/var/www/tmp/whiteraven-blog

DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=whiteraven_blog
DJANGO_DB_USER=whiteraven_blog
DJANGO_DB_PASSWORD=replace-with-a-strong-database-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

# Email (Brevo SMTP). With DJANGO_EMAIL_HOST empty, mail is printed to the
# console instead of sent.
SITE_URL=https://blog.wh1teraven.site
DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
# Brevo: Settings > SMTP & API > SMTP. The login looks like 123abc@smtp-brevo.com
# and the password is an SMTP key, not your account password.
DJANGO_EMAIL_HOST_USER=replace-with-brevo-smtp-login
DJANGO_EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
# Must be a sender or domain verified in Brevo.
DJANGO_DEFAULT_FROM_EMAIL="wh1t3r4v3n <newsletter@wh1teraven.site>"
# Contact-form messages are forwarded here. Leave empty to only store them.
CONTACT_NOTIFY_EMAIL=replace-with-your-inbox@example.com
# Brevo's free plan sends 300 a day; this leaves room for confirmations.
NEWSLETTER_DAILY_SEND_LIMIT=250
NEWSLETTER_CONFIRMATIONS_PER_HOUR=30

VITE_API_BASE_URL=/api
